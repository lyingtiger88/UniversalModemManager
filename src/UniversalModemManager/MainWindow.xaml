<Window
    x:Class="UniversalModemManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Universal Modem Manager">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Glyph="&#xE774;" FontSize="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="Universal Modem Manager"
                       Margin="10,0,0,0"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <Border Grid.Column="2"
                    x:Name="TitleProfileBadge"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    CornerRadius="12"
                    Padding="10,4"
                    VerticalAlignment="Center">
                <TextBlock x:Name="TitleProfileText"
                           Text="No modem registered"
                           FontSize="12" />
            </Border>
        </Grid>

        <NavigationView Grid.Row="1"
                        x:Name="RootNavigation"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        OpenPaneLength="240"
                        CompactPaneLength="52"
                        SelectionChanged="RootNavigation_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" Icon="Home" IsSelected="True" />
                <NavigationViewItem Content="Modem profile" Tag="modem">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE839;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Network" Tag="network" Icon="Globe" />
                <NavigationViewItem Content="Wi-Fi" Tag="wifi">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE701;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Connected devices" Tag="clients" Icon="People" />
                <NavigationViewItem Content="Traffic" Tag="traffic">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="SMS" Tag="sms">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Diagnostics" Tag="diagnostics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Grid Padding="28,22,28,28">

                    <ScrollViewer x:Name="DashboardPage"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18" MaxWidth="1180"
                                    HorizontalAlignment="Stretch">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Dashboard"
                                               FontSize="32"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="A unified view of the registered modem and the features exposed by its adapter."
                                               Opacity="0.7"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Refresh"
                                        Click="RefreshDashboard_Click"
                                        VerticalAlignment="Bottom" />
                            </Grid>

                            <InfoBar x:Name="ProfileInfoBar"
                                     IsOpen="True"
                                     IsClosable="False"
                                     Severity="Informational"
                                     Title="No modem profile is locked"
                                     Message="Open Modem profile, choose a model and register it. The app will then keep that identity locked until you explicitly unlock it." />

                            <InfoBar x:Name="DashboardStatusBar"
                                     IsOpen="False"
                                     IsClosable="True" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Registered modem" Opacity="0.7" />
                                        <TextBlock x:Name="DashboardModemText"
                                                   Text="Not registered"
                                                   Style="{StaticResource MetricValueStyle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="DashboardGatewayText"
                                                   Text="Gateway —"
                                                   Opacity="0.7" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Connection" Opacity="0.7" />
                                        <TextBlock x:Name="DashboardConnectionText"
                                                   Text="—"
                                                   Style="{StaticResource MetricValueStyle}" />
                                        <TextBlock x:Name="DashboardConnectionDetailText"
                                                   Text="No live data"
                                                   Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Signal" Opacity="0.7" />
                                        <TextBlock x:Name="DashboardSignalText"
                                                   Text="—"
                                                   Style="{StaticResource MetricValueStyle}" />
                                        <TextBlock x:Name="DashboardSignalDetailText"
                                                   Text="No live data"
                                                   Opacity="0.7" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Clients" Opacity="0.7" />
                                        <TextBlock x:Name="DashboardClientsText"
                                                   Text="—"
                                                   Style="{StaticResource MetricValueStyle}" />
                                        <TextBlock x:Name="DashboardClientsDetailText"
                                                   Text="No live data"
                                                   Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Live modem details"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <Grid ColumnSpacing="20" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Firmware" Opacity="0.65" />
                                            <TextBlock x:Name="DashboardFirmwareText" Text="—" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="WAN IP" Opacity="0.65" />
                                            <TextBlock x:Name="DashboardWanIpText" Text="—" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock Text="Battery" Opacity="0.65" />
                                            <TextBlock x:Name="DashboardBatteryText" Text="—" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Spacing="3">
                                            <TextBlock Text="RSRP / RSRQ" Opacity="0.65" />
                                            <TextBlock x:Name="DashboardRsrpRsrqText" Text="—" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                            <TextBlock Text="SINR" Opacity="0.65" />
                                            <TextBlock x:Name="DashboardSinrText" Text="—" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="3">
                                            <TextBlock Text="Wi-Fi SSID" Opacity="0.65" />
                                            <TextBlock x:Name="DashboardSsidText" Text="—" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Capability-driven interface"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Features such as SMS, APN, traffic, client blocking and band control will only activate when the selected adapter confirms support. Unsupported controls will never send guessed commands to a modem."
                                                   TextWrapping="Wrap"
                                                   Opacity="0.75" />
                                    </StackPanel>

                                    <FontIcon Grid.Column="1"
                                              Glyph="&#xE946;"
                                              FontSize="30"
                                              Opacity="0.65"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ModemPage"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18" MaxWidth="960"
                                    HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Modem profile"
                                           FontSize="32"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Choose, verify, register and lock the modem used by this Windows profile."
                                           Opacity="0.7" />
                            </StackPanel>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Registered profile"
                                                       Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock x:Name="ProfileStateText"
                                                       Text="No profile"
                                                       Margin="0,4,0,0"
                                                       Opacity="0.7" />
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                x:Name="LockBadge"
                                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                CornerRadius="12"
                                                Padding="10,4"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon x:Name="LockBadgeIcon" Glyph="&#xE72E;" FontSize="12" />
                                                <TextBlock x:Name="LockBadgeText" Text="Unlocked" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Manufacturer" />
                                            <ComboBox x:Name="BrandComboBox"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="BrandComboBox_SelectionChanged" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Model" />
                                            <ComboBox x:Name="ModelComboBox"
                                                      HorizontalAlignment="Stretch" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Spacing="6">
                                            <TextBlock Text="Profile name" />
                                            <TextBox x:Name="ProfileNameBox"
                                                     PlaceholderText="Home modem" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Gateway / admin address" />
                                            <TextBox x:Name="GatewayBox"
                                                     Text="http://192.168.1.1"
                                                     PlaceholderText="http://192.168.1.1" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="6">
                                            <TextBlock Text="Adapter" />
                                            <ComboBox x:Name="AdapterComboBox"
                                                      HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Lock after successful registration"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="When locked, the application refuses to silently change to a different modem profile."
                                                       Opacity="0.65"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <ToggleSwitch x:Name="LockAfterRegisterSwitch"
                                                      Grid.Column="1"
                                                      IsOn="True"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="8">
                                        <Button x:Name="UnlockProfileButton"
                                                Content="Unlock profile"
                                                Click="UnlockProfile_Click"
                                                IsEnabled="False" />
                                        <Button Content="Probe modem"
                                                Click="ProbeModem_Click" />
                                        <Button x:Name="RegisterButton"
                                                Content="Register modem"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="RegisterModem_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <InfoBar x:Name="ProbeResultBar"
                                     IsOpen="False"
                                     IsClosable="True" />

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Admin login"
                                                       Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="Credentials are sent only to the selected modem. The password is never written to the modem profile."
                                                       Opacity="0.65"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                CornerRadius="12"
                                                Padding="10,4"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="AuthenticationStateText"
                                                       Text="Not checked"
                                                       FontSize="12" />
                                        </Border>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Username" />
                                            <TextBox x:Name="AdminUsernameBox"
                                                     Text="admin"
                                                     PlaceholderText="admin" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Password" />
                                            <PasswordBox x:Name="AdminPasswordBox"
                                                         PlaceholderText="Modem admin password"
                                                         PasswordRevealMode="Peek" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="8">
                                        <Button Content="Check login state"
                                                Click="CheckLoginState_Click" />
                                        <Button x:Name="AdminLoginButton"
                                                Content="Login"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="AdminLogin_Click" />
                                    </StackPanel>

                                    <InfoBar x:Name="LoginInfoBar"
                                             IsOpen="False"
                                             IsClosable="True" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="NetworkPage"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18" MaxWidth="1060"
                                    HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Network"
                                               FontSize="32"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Live cellular network information reported by the active modem adapter."
                                               Opacity="0.7"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Refresh"
                                        Click="RefreshNetwork_Click"
                                        VerticalAlignment="Bottom" />
                            </Grid>

                            <InfoBar x:Name="NetworkInfoBar"
                                     IsOpen="False"
                                     IsClosable="True" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="Connection" Opacity="0.65" />
                                        <TextBlock x:Name="NetworkConnectionText"
                                                   Text="—"
                                                   Style="{StaticResource MetricValueStyle}" />
                                        <TextBlock x:Name="NetworkTypeText"
                                                   Text="—"
                                                   Opacity="0.7" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="Operator" Opacity="0.65" />
                                        <TextBlock x:Name="NetworkOperatorText"
                                                   Text="—"
                                                   Style="{StaticResource MetricValueStyle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="NetworkOperatorCodeText"
                                                   Text="—"
                                                   Opacity="0.7" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="Signal" Opacity="0.65" />
                                        <TextBlock x:Name="NetworkSignalText"
                                                   Text="—"
                                                   Style="{StaticResource MetricValueStyle}" />
                                        <TextBlock x:Name="NetworkRoamingText"
                                                   Text="Roaming —"
                                                   Opacity="0.7" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="24" RowSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="WAN IP" Opacity="0.65" />
                                        <TextBlock x:Name="NetworkWanIpText" Text="—" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="RSRP" Opacity="0.65" />
                                        <TextBlock x:Name="NetworkRsrpText" Text="—" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="RSRQ" Opacity="0.65" />
                                        <TextBlock x:Name="NetworkRsrqText" Text="—" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Spacing="3">
                                        <TextBlock Text="SINR" Opacity="0.65" />
                                        <TextBlock x:Name="NetworkSinrText" Text="—" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Battery" Opacity="0.65" />
                                        <TextBlock x:Name="NetworkBatteryText" Text="—" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="WifiPage"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18" MaxWidth="1060"
                                    HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Wi-Fi"
                                               FontSize="32"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Wireless configuration read directly from the modem API."
                                               Opacity="0.7" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Refresh"
                                        Click="RefreshWifi_Click"
                                        VerticalAlignment="Bottom" />
                            </Grid>

                            <InfoBar x:Name="WifiInfoBar"
                                     IsOpen="False"
                                     IsClosable="True" />

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Wireless network"
                                               Style="{StaticResource SectionTitleStyle}" />

                                    <Grid ColumnSpacing="22" RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Spacing="3">
                                            <TextBlock Text="SSID" Opacity="0.65" />
                                            <TextBlock x:Name="WifiSsidText"
                                                       Text="—"
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Radio" Opacity="0.65" />
                                            <TextBlock x:Name="WifiEnabledText" Text="—" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock Text="Visibility" Opacity="0.65" />
                                            <TextBlock x:Name="WifiHiddenText" Text="—" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Spacing="3">
                                            <TextBlock Text="Mode" Opacity="0.65" />
                                            <TextBlock x:Name="WifiModeText" Text="—" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                            <TextBlock Text="Channel" Opacity="0.65" />
                                            <TextBlock x:Name="WifiChannelText" Text="—" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="3">
                                            <TextBlock Text="Max clients" Opacity="0.65" />
                                            <TextBlock x:Name="WifiMaxClientsText" Text="—" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Spacing="3">
                                            <TextBlock Text="Client isolation" Opacity="0.65" />
                                            <TextBlock x:Name="WifiIsolationText" Text="—" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Change Wi-Fi settings"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Changes are sent directly to the modem. Changing SSID, channel or radio state may disconnect this PC from Wi-Fi."
                                               Opacity="0.68"
                                               TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="14" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="SSID" />
                                            <TextBox x:Name="WifiSsidEditBox"
                                                     PlaceholderText="Wi-Fi network name" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Channel" />
                                            <TextBox x:Name="WifiChannelEditBox"
                                                     PlaceholderText="0 = Auto" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock Text="Max clients" />
                                            <NumberBox x:Name="WifiMaxClientsNumberBox"
                                                       Minimum="1"
                                                       Maximum="64"
                                                       SpinButtonPlacementMode="Compact" />
                                        </StackPanel>

                                        <ToggleSwitch x:Name="WifiEnabledSwitch"
                                                      Grid.Row="1"
                                                      Header="Wi-Fi radio"
                                                      OnContent="On"
                                                      OffContent="Off" />

                                        <ToggleSwitch x:Name="WifiHiddenSwitch"
                                                      Grid.Row="1"
                                                      Grid.Column="1"
                                                      Header="Hide SSID"
                                                      OnContent="Hidden"
                                                      OffContent="Visible" />

                                        <ToggleSwitch x:Name="WifiIsolationSwitch"
                                                      Grid.Row="1"
                                                      Grid.Column="2"
                                                      Header="Client isolation"
                                                      OnContent="On"
                                                      OffContent="Off" />
                                    </Grid>

                                    <Button x:Name="ApplyWifiSettingsButton"
                                            Content="Apply Wi-Fi settings"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Right"
                                            Click="ApplyWifiSettings_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="SmsPage"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="SMS"
                                           FontSize="32"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Browse and send messages through the modem's native SMS API."
                                           Opacity="0.7" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Bottom">
                                <ComboBox x:Name="SmsBoxComboBox"
                                          Width="120"
                                          SelectedIndex="0"
                                          SelectionChanged="SmsBoxComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Inbox" />
                                    <ComboBoxItem Content="Sent" />
                                    <ComboBoxItem Content="Draft" />
                                </ComboBox>
                                <Button Content="Refresh"
                                        Click="RefreshSms_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Messages"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock x:Name="SmsCountsText"
                                                   Text="Inbox — • Unread — • Sent — • Draft —"
                                                   Opacity="0.65"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <ListView Grid.Row="2"
                                              x:Name="SmsListView"
                                              SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10"
                                                        Margin="0,0,0,6"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        CornerRadius="8">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="{Binding Phone}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Preview}"
                                                                       TextWrapping="Wrap"
                                                                       MaxLines="3"
                                                                       Opacity="0.82" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1"
                                                                    HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Date}"
                                                                       FontSize="12"
                                                                       Opacity="0.65" />
                                                            <TextBlock Text="{Binding ReadState}"
                                                                       FontSize="12"
                                                                       Opacity="0.65"
                                                                       HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <StackPanel Grid.Row="4"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Right">
                                        <Button Content="Mark read"
                                                Click="MarkSmsRead_Click" />
                                        <Button Content="Delete"
                                                Click="DeleteSms_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="14">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="New message"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Phone number" />
                                            <TextBox x:Name="SmsPhoneBox"
                                                     PlaceholderText="+33..." />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Message" />
                                            <TextBox x:Name="SmsMessageBox"
                                                     PlaceholderText="Write a message..."
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="140" />
                                        </StackPanel>
                                        <Button x:Name="SendSmsButton"
                                                Content="Send SMS"
                                                Style="{StaticResource AccentButtonStyle}"
                                                HorizontalAlignment="Right"
                                                Click="SendSms_Click" />
                                    </StackPanel>
                                </Border>

                                <InfoBar x:Name="SmsInfoBar"
                                         IsOpen="False"
                                         IsClosable="True" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ClientsPage"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Connected devices"
                                           FontSize="32"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Devices reported by the modem's Wi-Fi host API."
                                           Opacity="0.7" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Click="RefreshClients_Click"
                                    VerticalAlignment="Bottom" />
                        </Grid>

                        <InfoBar Grid.Row="2"
                                 x:Name="ClientsInfoBar"
                                 IsOpen="False"
                                 IsClosable="True" />

                        <Border Grid.Row="4"
                                Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Active clients"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="ClientsCountText"
                                               Grid.Column="1"
                                               Text="0 devices"
                                               Opacity="0.65"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <ListView Grid.Row="2"
                                          x:Name="ClientsListView"
                                          SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="12"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="1.3*" />
                                                        <ColumnDefinition Width="1.5*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding HostName}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ConnectedTimeDisplay}"
                                                                   FontSize="12"
                                                                   Opacity="0.65" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding IpAddress}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding MacAddress}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding UploadDisplay}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding DownloadDisplay}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding TotalUsageDisplay}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="TrafficPage"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18" MaxWidth="1100"
                                    HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Traffic"
                                               FontSize="32"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Live and cumulative data counters reported by the modem."
                                               Opacity="0.7" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Refresh"
                                        Click="RefreshTraffic_Click"
                                        VerticalAlignment="Bottom" />
                            </Grid>

                            <InfoBar x:Name="TrafficInfoBar"
                                     IsOpen="False"
                                     IsClosable="True" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Current session"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Connected time" Opacity="0.65" />
                                        <TextBlock x:Name="TrafficSessionTimeText"
                                                   Text="—"
                                                   Style="{StaticResource MetricValueStyle}" />
                                        <TextBlock x:Name="TrafficSessionUploadText"
                                                   Text="Upload —" />
                                        <TextBlock x:Name="TrafficSessionDownloadText"
                                                   Text="Download —" />
                                        <TextBlock x:Name="TrafficSessionTotalText"
                                                   Text="Total —"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Live speed"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Upload rate" Opacity="0.65" />
                                        <TextBlock x:Name="TrafficUploadRateText"
                                                   Text="—"
                                                   Style="{StaticResource MetricValueStyle}" />
                                        <TextBlock Text="Download rate" Opacity="0.65" />
                                        <TextBlock x:Name="TrafficDownloadRateText"
                                                   Text="—"
                                                   Style="{StaticResource MetricValueStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Current month"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Connected time" Opacity="0.65" />
                                        <TextBlock x:Name="TrafficMonthTimeText"
                                                   Text="—"
                                                   Style="{StaticResource MetricValueStyle}" />
                                        <TextBlock x:Name="TrafficMonthUploadText"
                                                   Text="Upload —" />
                                        <TextBlock x:Name="TrafficMonthDownloadText"
                                                   Text="Download —" />
                                        <TextBlock x:Name="TrafficMonthTotalText"
                                                   Text="Total —"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Lifetime time" Opacity="0.65" />
                                        <TextBlock x:Name="TrafficTotalTimeText"
                                                   Text="—"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="Lifetime upload" Opacity="0.65" />
                                        <TextBlock x:Name="TrafficTotalUploadText"
                                                   Text="—"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="5">
                                        <TextBlock Text="Lifetime download" Opacity="0.65" />
                                        <TextBlock x:Name="TrafficTotalDownloadText"
                                                   Text="—"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="5">
                                        <TextBlock Text="Lifetime total" Opacity="0.65" />
                                        <TextBlock x:Name="TrafficGrandTotalText"
                                                   Text="—"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="DiagnosticsPage"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Diagnostics"
                                           FontSize="32"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Run real connectivity, API, authentication and capability checks against the registered modem."
                                           Opacity="0.7"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="RunDiagnosticsButton"
                                    Grid.Column="1"
                                    Content="Run diagnostics"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="RunDiagnostics_Click"
                                    VerticalAlignment="Bottom" />
                        </Grid>

                        <InfoBar Grid.Row="2"
                                 x:Name="DiagnosticsInfoBar"
                                 IsOpen="False"
                                 IsClosable="True" />

                        <Border Grid.Row="4"
                                Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Diagnostic results"
                                           Style="{StaticResource SectionTitleStyle}" />

                                <ListView Grid.Row="2"
                                          x:Name="DiagnosticsListView"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="12"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="8">
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="3*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Test}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Status}"
                                                               Margin="10,0"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Detail}"
                                                               TextWrapping="Wrap"
                                                               Opacity="0.75" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding DurationDisplay}"
                                                               Opacity="0.65" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="PlaceholderPage"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" MaxWidth="900">
                            <TextBlock x:Name="PlaceholderTitle"
                                       Text="Feature"
                                       FontSize="32"
                                       FontWeight="SemiBold" />
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="10">
                                    <FontIcon Glyph="&#xE896;" FontSize="28"
                                              HorizontalAlignment="Left" />
                                    <TextBlock x:Name="PlaceholderMessage"
                                               Text="This page will be activated by modem adapters that expose the required capability."
                                               TextWrapping="Wrap"
                                               Opacity="0.75" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
